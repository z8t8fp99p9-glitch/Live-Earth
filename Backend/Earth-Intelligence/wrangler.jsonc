{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-earth-intelligence-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "EARTH_INTELLIGENCE_DB",
      "database_name": "live-earth-intelligence",
      // Replace this valid placeholder UUID with the ID returned by `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *",
      "31 3 * * *"
    ]
  },
  "vars": {
    // Exact origin only: scheme + hostname, no path or trailing slash.
    "APP_ORIGIN": "https://REPLACE-WITH-YOUR-LIVE-EARTH-DOMAIN"
  }
}
